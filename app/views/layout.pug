block vars
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title ? `UniSwap – ${title}` : "UniSwap"
    link(rel="stylesheet", href="/styles.css")
    block head
  body
    header.site-header
      nav.site-nav(role="navigation" aria-label="Main")
        a.nav-brand(href="/") UniSwap
        input#nav-toggle.nav-toggle(type="checkbox" aria-hidden="true")
        label.nav-burger(for="nav-toggle" aria-label="Toggle navigation")
          span
          span
          span
        ul.nav-links
          li: a.nav-link(href="/" class=(activeNav==="home" ? "is-active" : "")) Home
          li: a.nav-link(href="/listings" class=(activeNav==="listings" ? "is-active" : "")) Listings
          li: a.nav-link(href="/users" class=(activeNav==="users" ? "is-active" : "")) Users
          li: a.nav-link(href="/tags" class=(activeNav==="tags" ? "is-active" : "")) Tags
          if loggedInUser
            li: a.nav-link(href=`/users/${loggedInUser.id}`) My Profile
            li: a.nav-link.nav-link-danger(href="/logout") Logout
          else
            li: a.nav-link(href="/login") Log In
            li: a.nav-link.nav-link-cta(href="/signup") Sign Up

    main.site-main
      block content

    footer.site-footer
      .site-footer-inner
        p.footer-text © 2026 UniSwap – Built for students
        p.footer-text.footer-tagline Share. Save. Support your community.
