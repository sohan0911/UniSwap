extends layout

block vars
  - var title = "Tags"
  - var activeNav = "tags"

block content
  .page-header
    h1 Tags
    p.page-lead Browse listings by topic.

  if tags && tags.length
    ul.tags-list
      each tag in tags
        li
          a.tag(href=`/tags/${tag.id}`)= tag.name
  else
    .alert.alert-warning No tags available
