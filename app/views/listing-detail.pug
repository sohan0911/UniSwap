extends layout

block vars
  - var title = listing ? listing.title : "Listing"
  - var activeNav = "listings"

block content
  p.nav-back
    a(href="/listings") ← All listings

  if listing
    article.listing-detail-card
      if listing.image_url
        .listing-image-wrap
          img.listing-image(src=listing.image_url, alt=listing.title)
      else
        .listing-image-placeholder(aria-hidden="true") No image available
      h1.listing-detail-title= listing.title
      if listing.price != null && listing.price !== undefined
        p.listing-price Price: #{listing.price}
      p.listing-description= listing.description
      if listing.has_item || listing.wants_item
        section.listing-swap-meta
          h2 Swap details
          if listing.has_item
            p
              strong Has:&nbsp;
              span= listing.has_item
          if listing.wants_item
            p
              strong Wants:&nbsp;
              span= listing.wants_item
      if listing.owner_name || listing.owner_email
        section.listing-owner
          h2 Owner
          if listing.owner_name
            p= listing.owner_name
          if listing.owner_email
            p.text-muted= listing.owner_email
      section.listing-tags-section
        h2 Tags
        if tags && tags.length
          ul.tags-list
            each tag in tags
              li
                a.tag(href=`/tags/${tag.id}`)= tag.name
        else
          p.text-muted No tags available

    if loggedInUser && listing.user_id != loggedInUser.id
      section.swap-request
        form.form-card(action="/swaps/request" method="POST")
          h2 Request a swap
          input(type="hidden" name="target_listing_id" value=listing.id)
          if myListings && myListings.length
            .form-group
              label(for="my_listing_id") Choose one of your listings
              select.form-control(name="my_listing_id" id="my_listing_id" required)
                each ml in myListings
                  option(value=ml.id)= `${ml.title} (has: ${ml.has_item || '—'} / wants: ${ml.wants_item || '—'})`
            button.btn.btn-primary(type="submit") Send swap request
          else
            p.text-muted You don’t have any listings yet. Add one first to request a swap.
            p
              a.btn.btn-secondary(href="/listings/new") + Add listing

    section.listing-ratings
      h2 Ratings
      if ratings && ratings.length
        each r in ratings
          .rating-item
            p.rating-score Rating: #{r.rating}/5
            if r.comment
              p.rating-comment= r.comment
            p.text-muted By #{r.user_name}
      else
        p.text-muted No ratings yet.

      form.form-card(action=`/listings/${listing.id}/rate` method="POST")
        h3 Leave a Rating
        .form-group
          label(for="rating") Rating (1–5):
          select.form-control(name="rating" id="rating" required)
            option(value="1") 1
            option(value="2") 2
            option(value="3") 3
            option(value="4") 4
            option(value="5") 5
        .form-group
          label(for="comment") Comment:
          textarea.form-control(name="comment" id="comment" rows="3")
        button.btn.btn-primary(type="submit") Submit Rating

    if recommendations && recommendations.length
      section.recommendations
        h2 Recommended listings
        ul.listings-page-list
          each rec in recommendations
            li.listing-row
              a.listing-row-title(href=`/listings/${rec.id}`)= rec.title
              if rec.has_item || rec.wants_item
                p.listing-row-desc
                  | Has: #{rec.has_item || '—'} · Wants: #{rec.wants_item || '—'}
  else
    .alert.alert-error Listing not found
